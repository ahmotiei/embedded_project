# Template for the later C MQTT client service.
# Do not enable until the MQTT client binary is implemented.
[Unit]
Description=Smart Guard MQTT client
Requires=network-online.target smart-guard-vision.service
After=network-online.target smart-guard-vision.service
Wants=smart-guard-web.service

[Service]
Type=simple
User=smartguard
Group=smartguard
EnvironmentFile=/etc/smart-guard/mqtt.env
ExecStart=/opt/smart-guard/bin/smart_guard_mqtt
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
