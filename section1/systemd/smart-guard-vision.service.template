# Template for the later image-processing service.
# Do not enable until the vision binary/script is implemented.
[Unit]
Description=Smart Guard person-detection service
Requires=network-online.target
After=network-online.target
Before=smart-guard-web.service smart-guard-mqtt.service

[Service]
Type=simple
User=smartguard
Group=smartguard
ExecStart=/opt/smart-guard/bin/smart_guard_vision
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
