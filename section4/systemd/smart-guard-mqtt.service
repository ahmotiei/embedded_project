[Unit]
Description=Smart Guard Section 4 C controller (MQTT, email, black box, thermal)
Wants=network-online.target smart-guard-vision.service
Requires=smart-guard-web.service
After=network-online.target smart-guard-web.service smart-guard-vision.service

[Service]
Type=simple
User=smartguard
Group=smartguard
EnvironmentFile=/etc/smart-guard/section4.env
EnvironmentFile=/etc/smart-guard/mqtt.env
EnvironmentFile=/etc/smart-guard/alerts.env
StateDirectory=smart-guard
StateDirectoryMode=0750
ExecStart=/opt/smart-guard/bin/smart_guard_notifier
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
Nice=5
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/smart-guard /run/smart-guard

[Install]
WantedBy=multi-user.target
