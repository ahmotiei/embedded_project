# Secret email configuration. Store as /etc/smart-guard/alerts.env, mode 0640.
# Fresh installs use 0 until valid SMTP credentials are entered. Set to 1 for the final demonstration.
SMART_GUARD_EMAIL_ENABLED=0

# Gmail example: smtps://smtp.gmail.com:465 (use an App Password)
# STARTTLS example: smtp://smtp.example.com:587
SMART_GUARD_SMTP_URL=smtps://smtp.gmail.com:465
SMART_GUARD_SMTP_USERNAME=your_account@example.com
SMART_GUARD_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
SMART_GUARD_EMAIL_FROM=your_account@example.com
SMART_GUARD_EMAIL_TO=destination@example.com

# Keep verification enabled. Set a custom CA file only when necessary.
SMART_GUARD_SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
SMART_GUARD_SMTP_INSECURE=0
