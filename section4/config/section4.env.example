# Smart Guard Section 4 non-secret configuration (VM/OrangePi)
SMART_GUARD_STUDENT_ID=401102553

# Camera flow: physical host -> vision relay:9200 -> C web core:9100
SMART_GUARD_VISION_LISTEN_HOST=0.0.0.0
SMART_GUARD_VISION_LISTEN_PORT=9200
SMART_GUARD_VISION_FORWARD_HOST=127.0.0.1
SMART_GUARD_VISION_FORWARD_PORT=9100
SMART_GUARD_VISION_HOG_THRESHOLD=0.15
SMART_GUARD_VISION_HOG_SCALE=1.05
SMART_GUARD_VISION_JPEG_QUALITY=85
SMART_GUARD_VISION_MAX_FRAME_BYTES=8388608
SMART_GUARD_ZERO_CONFIRM_FRAMES=2
SMART_GUARD_EVENT_KEEP_COUNT=100
SMART_GUARD_VISION_CONTROL_REFRESH_SECONDS=1.0

SMART_GUARD_PERSON_FILE=/run/smart-guard/person_count
SMART_GUARD_EVENT_FILE=/run/smart-guard/detection_event.json
SMART_GUARD_EVENT_DIR=/run/smart-guard/events
SMART_GUARD_VISION_STATUS_FILE=/run/smart-guard/vision_status.json
SMART_GUARD_VISION_CONTROL_FILE=/run/smart-guard/vision_control.json
SMART_GUARD_THERMAL_STATUS_FILE=/run/smart-guard/thermal_status.json
SMART_GUARD_SYSTEM_EVENT_FILE=/run/smart-guard/system_event.json

# Anti-theft guard state. The HTTPS dashboard and API update this file.
SMART_GUARD_GUARD_STATE_FILE=/var/lib/smart-guard/guard_mode

# Persistent SQLite black box with a bounded circular record set.
SMART_GUARD_BLACKBOX_DB=/var/lib/smart-guard/blackbox.db
SMART_GUARD_BLACKBOX_DIR=/var/lib/smart-guard/blackbox
SMART_GUARD_BLACKBOX_CAPACITY=1000

# C controller reads telemetry from the loopback C API.
SMART_GUARD_TELEMETRY_URL=http://127.0.0.1:18080/api/v1/telemetry
SMART_GUARD_MQTT_ENABLED=1
SMART_GUARD_MQTT_INTERVAL=2
SMART_GUARD_EVENT_POLL_MS=200
SMART_GUARD_EMAIL_DEBOUNCE_SECONDS=30

# Section 3/4 persistent event state.
SMART_GUARD_EMAIL_STATE_FILE=/var/lib/smart-guard/last_email_epoch
SMART_GUARD_EVENT_STATE_FILE=/var/lib/smart-guard/last_mqtt_event_id
SMART_GUARD_EMAIL_EVENT_STATE_FILE=/var/lib/smart-guard/last_email_event_id
SMART_GUARD_SEEN_EVENT_STATE_FILE=/var/lib/smart-guard/last_seen_event_id
SMART_GUARD_ALARM_MQTT_STATE_FILE=/var/lib/smart-guard/last_alarm_mqtt_event_id
SMART_GUARD_ALARM_EMAIL_STATE_FILE=/var/lib/smart-guard/last_alarm_email_event_id
SMART_GUARD_SYSTEM_EVENT_STATE_FILE=/var/lib/smart-guard/last_system_event_id

# Adaptive thermal management. Lower HIGH_C temporarily for the graded test
# only when the real hardware cannot reach the default threshold safely.
SMART_GUARD_THERMAL_HIGH_C=75.0
SMART_GUARD_THERMAL_HYSTERESIS_C=5.0
SMART_GUARD_THERMAL_STATE_FILE=/var/lib/smart-guard/thermal_active
SMART_GUARD_NORMAL_MAX_FPS=0
SMART_GUARD_NORMAL_DETECTION_WIDTH=640
SMART_GUARD_NORMAL_OUTPUT_WIDTH=0
SMART_GUARD_THERMAL_MAX_FPS=4
SMART_GUARD_THERMAL_DETECTION_WIDTH=320
SMART_GUARD_THERMAL_OUTPUT_WIDTH=480

# Software watchdog. It treats the vision status-file mtime as the processed
# frame heartbeat. It emits a camera-tamper event and restarts vision once per
# outage; a fresh frame clears the incident latch.
SMART_GUARD_WATCHDOG_HEARTBEAT_FILE=/run/smart-guard/vision_status.json
SMART_GUARD_WATCHDOG_TIMEOUT_SECONDS=30
SMART_GUARD_WATCHDOG_STARTUP_GRACE_SECONDS=45
SMART_GUARD_WATCHDOG_CHECK_INTERVAL_SECONDS=2
SMART_GUARD_WATCHDOG_SERVICE=smart-guard-vision.service
