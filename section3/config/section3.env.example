# Non-secret Section 3 configuration (VM)
SMART_GUARD_STUDENT_ID=401102553

# Camera flow: physical host -> vision relay:9200 -> C web core:9100
SMART_GUARD_VISION_LISTEN_HOST=0.0.0.0
SMART_GUARD_VISION_LISTEN_PORT=9200
SMART_GUARD_VISION_FORWARD_HOST=127.0.0.1
SMART_GUARD_VISION_FORWARD_PORT=9100
SMART_GUARD_VISION_DETECTION_WIDTH=640
SMART_GUARD_VISION_HOG_THRESHOLD=0.15
SMART_GUARD_VISION_HOG_SCALE=1.05
SMART_GUARD_VISION_JPEG_QUALITY=85
SMART_GUARD_VISION_MAX_FRAME_BYTES=8388608
SMART_GUARD_ZERO_CONFIRM_FRAMES=2

SMART_GUARD_PERSON_FILE=/run/smart-guard/person_count
SMART_GUARD_EVENT_FILE=/run/smart-guard/detection_event.json
SMART_GUARD_EVENT_DIR=/run/smart-guard/events
SMART_GUARD_VISION_STATUS_FILE=/run/smart-guard/vision_status.json
SMART_GUARD_EVENT_KEEP_COUNT=100

# The C notifier reads telemetry from the C core, not from FastAPI.
SMART_GUARD_TELEMETRY_URL=http://127.0.0.1:18080/api/v1/telemetry
SMART_GUARD_MQTT_INTERVAL=2
SMART_GUARD_EVENT_POLL_MS=200
SMART_GUARD_EMAIL_DEBOUNCE_SECONDS=30
SMART_GUARD_EMAIL_STATE_FILE=/var/lib/smart-guard/last_email_epoch
SMART_GUARD_EVENT_STATE_FILE=/var/lib/smart-guard/last_event_id
SMART_GUARD_EMAIL_EVENT_STATE_FILE=/var/lib/smart-guard/last_email_event_id
